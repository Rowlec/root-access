{
  "manifest_version": 3,
  "name": "RootAccess – Chấm Startup Proposal",
  "version": "0.1.0",
  "description": "Viết từng phần proposal trong ChatGPT/Gemini và chấm theo tiêu chí môn EXE.",
  "permissions": ["sidePanel", "storage"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://gemini.google.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Mở RootAccess"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://gemini.google.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://root-access-w.vercel.app/*",
      "http://localhost:3000/*"
    ]
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
